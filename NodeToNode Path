class Solution{
    public :
    bool getPath(TreeNode* root , vector<int>&arr , int x)
    {
        if(root == nullptr)
        {
            return false;
        }
        
        arr.push_back(root->val);
        
        if(root->val == x) return true;
        if (getPath(root->left,arr,x) || getPath(root->right,arr,x))
        {
            return true;
        }


        arr.pop_back();
        return false;

    }
    vector<int>NodeToNode(TreeNode* A , int B)
    {
        vector<int>arr;
        if(A == nullptr)
        {
            return arr;
        }
        getPath(A,arr,B);
        return arr;
    }
};
    

class Solution {
public:
    void rightLeft(TreeNode* root , int level , vector<int>&ds)
    {
        if(root == nullptr)
        {
            return ;
        }
        if(level == ds.size())
        {
            ds.push_back(root->val);
        }
        rightLeft(root->right,level+1,ds);
        rightLeft(root->left,level+1,ds);
    }
    
    vector<int> rightSideView(TreeNode* root) 
    {
        vector<int>ds;
        int level =0;
        rightLeft(root,level,ds);
        return ds;
    }
};
